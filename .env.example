# ============================================
# QA NLP Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=techqa_documents

# --- Model Paths ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
LLM_MODEL_PATH=models/llama-3.2-3b-techqa
# Or use HuggingFace hub directly:
# LLM_MODEL_NAME=unsloth/Llama-3.2-3B-Instruct-bnb-4bit

# --- API Settings ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- HuggingFace (for model download) ---
# HF_TOKEN=your_huggingface_token_here

# --- Device ---
# Options: cuda, cpu, mps
DEVICE=cuda
