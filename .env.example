# ============================================
# QA NLP Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Qdrant Vector Store (Local or Cloud) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION_NAME=techqa_corpus


# --- Model Paths & HuggingFace Hub ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
LLM_MODEL_PATH=models/Llama_TechQA
LLM_MODEL_NAME=AQUABOT/Llama-3.2-3B-TechQA

# --- API Settings ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- HuggingFace Token ---
HF_TOKEN=your_huggingface_token_here

# --- Device ---
# Options: cuda, cpu
DEVICE=cuda
